[user]
	email = lyhokia@gmail.com
	name = glyh
[core]
	pager = delta
	compression = 0
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[pull]
	rebase = false
[alias]
	l = log --oneline --decorate --graph -n 1000
	dl = -c diff.external=difft log -p --ext-diff
	d = diff
	dd = -c diff.external=difft diff
	ds = -c diff.external=difft show --ext-diff
	a = add
	c = commit
	o = checkout
	s = status
	f = config
	i = config --get-regexp alias
	t = difftool
	p = pull
	u = push
	g = clone --filter=blob:none -j8 --recurse-submodules --shallow-submodules
	submod = submodule update --init --recursive --depth 1
	b = branch
	cf = commit --amend
	r = restore
	root = rev-parse --show-toplevel
	cp = cherry-pick
[gpg]
	program = gpg2
[push]
	autoSetupRemote = true

[http]
	proxy = socks5://127.0.0.1:7897
[checkout]
	defaultRemote = origin
[init]
	defaultBranch = trunk
